generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionPlan {
  STARTER
  PRO
  PREMIUM
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  passwordHash     String?
  authProvider     String   @default("LOCAL") // "LOCAL" ou "GOOGLE"
  require2fa       Boolean  @default(false)
  twoFaSecret      String?
  backupCodes      String? // JSON array de codes de secours hashés

  // Champs pour la réinitialisation de mot de passe
  resetToken       String?
  resetTokenExpiry DateTime?

  isSuperAdmin     Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userTenants UserTenant[]
  auditLogs   AuditLog[]
  consents    ConsentRecord[]

  @@map("users")
}

model Tenant {
  id             String   @id @default(cuid())
  name           String
  regime         String   @default("REEL_NORMAL") // REEL_NORMAL, RSI, TPU
  nif            String?
  rccm           String?
  cnssNumber     String?
  centreFiscal   String?          @default("DPME Lomé") // DGE, DPME, DPI Golfe, DPI Agoè-Nyivé, Régions
  formeJuridique String?          @default("SARL") // EI, SARL, SAS, SA, ETS...
  secteurActivite String?
  phone          String?
  address        String?
  city           String?          @default("Lomé")
  exerciceOuvert Boolean          @default(true)
  plan           SubscriptionPlan @default(STARTER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  userTenants         UserTenant[]
  ecritures           Ecriture[]
  comptes             ComptePlan[]
  auditLogs           AuditLog[]
  calendarObligations CalendarObligation[]
  // BI & Data Analyse
  productRefs         ProductRef[]
  clientRefs          ClientRef[]
  sales               Sale[]
  purchases           Purchase[]
  forecasts           Forecast[]
  alerts              Alert[]
  // Revue Fiscale & CSP Auto-Évaluation
  cspEvaluations      CspEvaluation[]
  cspAttachments      CspAttachment[]
  anomaliesDetectees  AnomalieDetectee[]
  factureImageHashes  FactureImageHash[]

  @@map("tenants")
}

model UserTenant {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("GERANT") // GERANT, COMPTABLE, LECTURE, CABINET, ADMIN_SYS
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@map("user_tenants")
}

model Ecriture {
  id           String         @id @default(cuid())
  tenantId     String
  journal      String // ACHATS, VENTES, BANQUE, CAISSE, OD, PAIE
  date         String // YYYY-MM-DD
  piece        String
  libelle      String?
  status       String         @default("VALIDE") // BROUILLON, VALIDE, CLOTURE
  documentUrl  String? // URL ou Base64 de la pièce justificative (Facture/Reçu)
  documentName String? // Nom original du fichier (ex: Facture_FOURN_001.pdf)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  EcritureLine[]
  anomalies AnomalieDetectee[]

  @@map("ecritures")
}

model EcritureLine {
  id          String   @id @default(cuid())
  ecritureId  String
  accountCode String
  libelle     String
  debit       BigInt   @default(0) // Montants entiers FCFA
  credit      BigInt   @default(0) // Montants entiers FCFA
  createdAt   DateTime @default(now())

  ecriture Ecriture @relation(fields: [ecritureId], references: [id], onDelete: Cascade)

  @@map("ecriture_lines")
}

model ComptePlan {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  libelle   String
  classe    Int
  postable  Boolean  @default(true)
  isRoot    Boolean  @default(false)
  archived  Boolean  @default(false)
  refCode   String?
  type      String   @default("STANDARD")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("comptes_plan")
}

/// Référentiel SYSCOHADA commun à tous les dossiers. Les lignes officielles
/// sont immuables : seules les déclinaisons propres à un tenant sont modifiables.
model SyscohadaRef {
  code       String   @id
  libelle    String
  classe     Int
  nature     String
  sensNormal String
  postable   Boolean
  splittable Boolean  @default(true)
  source     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([classe])
  @@map("syscohada_refs")
}

model CalendarObligation {
  id        String   @id @default(cuid())
  tenantId  String
  key       String // "TVA-2026-08"
  label     String
  regime    String // REEL_NORMAL, RSI, TPU
  freq      String // MENSUELLE, TRIMESTRIELLE, ANNUELLE
  dueDate   String // YYYY-MM-DD
  legalRef  String // Réf CGI Togo / LPF
  status    String   @default("A_JOUR") // A_JOUR, A_PARAMETRER, TRANSMIS
  alerts    String   @default("{\"j7\":true,\"j3\":true,\"j0\":true}")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, dueDate])
  @@map("calendar_obligations")
}

model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String
  type      String // CGU, CONFIDENTIALITE (Loi n°2018-26 Togo)
  version   String   @default("1.0")
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consent_records")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ============================================================================
// BI & DATA ANALYSE (Module A - ADDENDUM N°1)
// ============================================================================

model ProductRef {
  id           String   @id @default(cuid())
  tenantId     String
  code         String // Identifiant unique produit
  designation  String
  category     String // Catégorie produit (pour analyse)
  priceVentHT  BigInt // Prix vente HT en FCFA entiers
  costAchatHT  BigInt // Coût achat HT en FCFA entiers
  margineCible Int    // Marge cible % (ex 30 pour 30%)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales     Sale[]
  purchases Purchase[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("product_refs")
}

model ClientRef {
  id              String   @id @default(cuid())
  tenantId        String
  code            String // Identifiant unique client
  name            String
  segment         String // Segment client (VIP, Normal, Petits…)
  zoneGeo         String // Zone géographique (Lomé, Kara, Agoe…)
  encoursAutorise BigInt // Encours autorisé en FCFA
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales  Sale[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("client_refs")
}

model Sale {
  id         String   @id @default(cuid())
  tenantId   String
  date       String // YYYY-MM-DD
  refFacture String // Référence facture
  clientId   String // FK ClientRef
  productId  String // FK ProductRef
  quantity   Int    // Quantité vendue
  puHT       BigInt // Prix unitaire HT (FCFA entiers)
  montantHT  BigInt // Montant HT = quantity × puHT
  tauxTVA    Int    // Taux TVA % (ex 18)
  montantTVA BigInt // Montant TVA
  montantTTC BigInt // Total TTC = HT + TVA
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  ClientRef  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product ProductRef @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([clientId])
  @@index([productId])
  @@map("sales")
}

model Purchase {
  id          String   @id @default(cuid())
  tenantId    String
  date        String // YYYY-MM-DD
  refCommande String // Référence commande
  supplierId  String // Identifiant fournisseur (texte libre, pas FK)
  productId   String // FK ProductRef
  quantity    Int    // Quantité achetée
  puHT        BigInt // Prix unitaire HT (FCFA entiers)
  montantHT   BigInt // Montant HT
  tauxTVA     Int    // Taux TVA %
  montantTVA  BigInt // Montant TVA
  montantTTC  BigInt // Total TTC
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product ProductRef @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([productId])
  @@map("purchases")
}

model Forecast {
  id         String   @id @default(cuid())
  tenantId   String
  type       String // CA, TRESORERIE, VENTE_PRODUIT
  date       String // YYYY-MM-DD (date de la prévision)
  value      BigInt // Valeur en FCFA
  lowerBound BigInt // Intervalle de confiance bas
  upperBound BigInt // Intervalle de confiance haut
  mape       Int // MAPE % (précision du modèle)
  metadata   String? // JSON: {"productId": "...", "horizon": 30} pour détails
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, date])
  @@map("forecasts")
}

model Alert {
  id           String   @id @default(cuid())
  tenantId     String
  type         String // VENTE_CHUTE, MARGE_NEG, ENCOURS_DEPASSE, ECART_COMPTA, STOCK_LENT
  severity     String // INFO, WARNING, CRITICAL
  title        String // Titre court
  message      String // Description détaillée
  acknowledged Boolean  @default(false)
  metadata     String? // JSON pour détails contextuels
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("alerts")
}

// ============================================================================
// REVUE FISCALE & CSP AUTO-ÉVALUATION (OTR TOGO)
// ============================================================================

model CspEvaluation {
  id              String   @id @default(cuid())
  tenantId        String
  exercice        String   // Ex: "2026"
  score           Int      // 0 à 100
  grade           String   // "A" (Conforme), "B" (Modéré), "C" (Critique)
  statut          String   @default("CONFORME") // CONFORME, A_REGULARISER, CRITIQUE
  hashCertificat  String   // SHA-256 de certification
  detailsJson     String   // Données détaillées des 7 piliers et des contrôles (JSON)
  recommendations String?  // Recommandations d'audit fiscales (JSON)
  generatedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attachments CspAttachment[]

  @@index([tenantId, exercice])
  @@map("csp_evaluations")
}

model CspAttachment {
  id           String   @id @default(cuid())
  tenantId     String
  evaluationId String?
  fileName     String
  fileType     String   // DSF, BALANCE, GRAND_LIVRE, AMORTISSEMENT, BANQUE, QUITTANCE, AUTRE
  mimeType     String   @default("application/pdf")
  fileSize     Int      // Taille en octets
  fileData     String   // Base64 ou URL du fichier
  fileHash     String   // Empreinte SHA-256
  notes        String?  // Commentaires ou références de la pièce
  uploadedAt   DateTime @default(now())

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluation CspEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([evaluationId])
  @@map("csp_attachments")
}
// ============================================================================
// DETECTION D'ANOMALIES (Non-conformite SYSCOHADA, facturation, ecarts declaratifs)
// ============================================================================

enum SeveriteAnomalie {
  INFO
  AVERTISSEMENT
  BLOQUANT
}

enum StatutAnomalie {
  A_EXAMINER
  IGNOREE
  CORRIGEE
}

enum TypeAnomalie {
  ECRITURE_DESEQUILIBREE
  NUMEROTATION_NON_CONTINUE
  COMPTE_HORS_MAPPING_JOURNAL
  FACTURE_NUMERO_DUPLIQUE
  FACTURE_TROU_SEQUENCE
  FACTURE_NIF_MANQUANT_OU_INVALIDE
  ECART_TVA_DECLAREE_VS_COLLECTEE
  PARTIE_LIEE_PRIX_ANORMAL
  TVA_INCOHERENTE_AVEC_TAUX
  LIGNE_MONTANT_INCOHERENT
  FACTURE_IMAGE_DUPLIQUEE
  NIF_NOM_INCOHERENT
  MONTANT_ANORMAL_VS_HISTORIQUE
  COMPTE_SYSCOHADA_INEXISTANT
  TAUX_SOCIAL_INCORRECT
  TAUX_RETENUE_INCORRECT
}

model AnomalieDetectee {
  id            String           @id @default(cuid())
  tenantId      String
  type          TypeAnomalie
  severite      SeveriteAnomalie
  description   String
  statut        StatutAnomalie   @default(A_EXAMINER)
  justification String?
  ecritureId    String?
  factureRef    String?
  metadata      String?
  detectedAt    DateTime         @default(now())
  resolvedAt    DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ecriture Ecriture? @relation(fields: [ecritureId], references: [id], onDelete: SetNull)

  @@index([tenantId, statut])
  @@index([tenantId, type])
  @@map("anomalies_detectees")
}
model FournisseurNifRef {
  tenantId String
  nif      String
  nom      String
  @@unique([tenantId, nif])
}


// ============================================================================
// DEDUPLICATION DES IMAGES DE FACTURES (Section 7 — post-CSP)
// ============================================================================

model FactureImageHash {
  id         String   @id @default(cuid())
  tenantId   String
  hashSha256 String
  ecritureId String?
  source     String   @default("OCR_SCAN") // "OCR_SCAN" | "MANUAL_UPLOAD" | "EXCEL_IMPORT"
  fileName   String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, hashSha256])
  @@index([tenantId])
  @@map("facture_image_hashes")
}