datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  require2fa   Boolean      @default(false)
  twoFaSecret  String?
  backupCodes  String?      // JSON array de codes de secours hashés
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  userTenants  UserTenant[]
  auditLogs    AuditLog[]
  consents     ConsentRecord[]

  @@map("users")
}

model Tenant {
  id                  String               @id @default(cuid())
  name                String
  regime              String               @default("REEL_NORMAL") // REEL_NORMAL, RSI, TPU
  nif                 String?
  exerciceOuvert      Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  userTenants         UserTenant[]
  ecritures           Ecriture[]
  comptes             ComptePlan[]
  auditLogs           AuditLog[]
  calendarObligations CalendarObligation[]

  @@map("tenants")
}

model UserTenant {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("GERANT") // GERANT, COMPTABLE, LECTURE, CABINET, ADMIN_SYS
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@map("user_tenants")
}

model Ecriture {
  id        String         @id @default(cuid())
  tenantId  String
  journal   String         // ACHATS, VENTES, BANQUE, CAISSE, OD, PAIE
  date      String         // YYYY-MM-DD
  piece     String
  libelle   String?
  status    String         @default("VALIDE") // BROUILLON, VALIDE, CLOTURE
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines     EcritureLine[]

  @@map("ecritures")
}

model EcritureLine {
  id          String   @id @default(cuid())
  ecritureId  String
  accountCode String
  libelle     String
  debit       Int      @default(0) // Montants entiers FCFA
  credit      Int      @default(0) // Montants entiers FCFA
  createdAt   DateTime @default(now())

  ecriture    Ecriture @relation(fields: [ecritureId], references: [id], onDelete: Cascade)

  @@map("ecriture_lines")
}

model ComptePlan {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  libelle   String
  classe    Int
  postable  Boolean  @default(true)
  type      String   @default("STANDARD")
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("comptes_plan")
}

model CalendarObligation {
  id        String   @id @default(cuid())
  tenantId  String
  key       String   // "TVA-2026-08"
  label     String
  regime    String   // REEL_NORMAL, RSI, TPU
  freq      String   // MENSUELLE, TRIMESTRIELLE, ANNUELLE
  dueDate   String   // YYYY-MM-DD
  legalRef  String   // Réf CGI Togo / LPF
  status    String   @default("A_JOUR") // A_JOUR, A_PARAMETRER, TRANSMIS
  alerts    String   @default("{\"j7\":true,\"j3\":true,\"j0\":true}")
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, dueDate])
  @@map("calendar_obligations")
}

model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String
  type      String   // CGU, CONFIDENTIALITE (Loi n°2018-26 Togo)
  version   String   @default("1.0")
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consent_records")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  details   String?
  createdAt DateTime @default(now())

  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
